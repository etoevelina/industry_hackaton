#!/bin/bash
# РАЗВЕДКА ИСТОЧНИКОВ LMS: открыть систему вуза и собрать черновик белого списка.
#
# Зачем из Terminal, а не двойным щелчком по приложению: разбор печатается
# ТЕКСТОМ и читается глазами. Главное в выводе — не список адресов, а строки
# «нужен потому что» и предупреждение про единый вход; окно их не вместит, и
# прятать такое в окно не следует.
#
# Это инструмент НАСТРОЙКИ, а не экзамен:
#   * режим kiosk не включается, блокировки не ставятся, окно обычное;
#   * фильтр запросов НИЧЕГО не блокирует — только записывает;
#   * собранный профиль НЕ ПРИМЕНЯЕТСЯ: он сохраняется черновиком, и список
#     обязан прочитать человек. Пока в файле стоят заглушки <...> и метка
#     ЧЕРНОВИК-НЕ-УТВЕРЖДЁН, сайдкар не считает экзамен готовым;
#   * правило инструмента: НЕ ОПОЗНАЛ — НЕ ВКЛЮЧИЛ. В белый список идут только
#     адрес экзамена, соседи по домену вуза и CDN, на который нельзя положить
#     свой файл. Прочее — в раздел «кандидаты», добавляет человек руками;
#   * прогоны в один --out НАКАПЛИВАЮТСЯ: прошлый файл не затирается,
#     вычеркнутое руками не возвращается, рядом остаётся копия *.bak.json.
#
# Запуск:
#   scripts/discover-origins.command https://lms.astanait.edu.kz/login/index.php
#   scripts/discover-origins.command <адрес> --out /путь/черновик.json
#   scripts/discover-origins.command <адрес> --seconds 40    # прогон без человека
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1
ROOT="$(pwd)"

URL="${1:-}"
if [ -n "$URL" ]; then shift; fi

if [ -z "$URL" ] || [ "$URL" = "--help" ] || [ "$URL" = "-h" ]; then
  cat <<'EOF'
Разведка источников LMS — собрать черновик белого списка по фактическим запросам.

  scripts/discover-origins.command <адрес страницы входа LMS> [ключи]

Ключи передаются инструменту как есть:
  --out PATH          куда сохранить черновик (по умолчанию exam-profile.draft.json)
  --institution NAME  название вуза
  --exam-id CODE      код экзамена
  --seconds N         автоматический прогон: сохранить и выйти через N секунд
  --mark-after N      автоматически отметить «вход завершён» через N секунд

В окне: «Вход завершён» (Cmd+Shift+L) делит источники на фазу входа и фазу
экзамена; «Сохранить черновик» (Cmd+S) печатает разбор и пишет файл.

Первые строки разбора — предупреждение о неполноте: собрано только то, что
прошли руками. Второй раздел — «чего разведка не видела»: какие типы ресурсов
не встретились ни разу, какие адреса страница предлагает ссылками и какие
лежат в тексте её скриптов, ни разу не запрошенные (так выглядит спящий
скрипт прокторинга вуза). Читать это надо ДО списка, а не после.
EOF
  exit 0
fi

case "$URL" in
  http://*|https://*) ;;
  *)
    echo "ОШИБКА: адрес должен начинаться с http:// или https:// — получено «$URL»" >&2
    exit 2
    ;;
esac

ELECTRON="$ROOT/node_modules/.bin/electron"
if [ ! -x "$ELECTRON" ]; then
  echo "ОШИБКА: не найден $ELECTRON" >&2
  echo "Поставьте зависимости оболочки: npm install (или make setup)" >&2
  exit 3
fi

if [ ! -x "$ROOT/.venv/bin/python3" ] && [ -z "${PROCTOR_PYTHON:-}" ]; then
  # Не отказ: без python инструмент соберёт черновик, но НЕ сможет спросить
  # ядро, подействует ли каждая запись. Молчать про это нельзя — «сверка не
  # выполнена» и «ядро всё приняло» разные вещи.
  echo "ВНИМАНИЕ: нет .venv/bin/python3 — сверка черновика с классификацией"
  echo "          ядра (sidecar/config.py) выполнена НЕ БУДЕТ. Это не значит,"
  echo "          что ядро примет все записи. Соберите окружение: make setup"
  echo
fi

echo "=== Разведка источников: $URL ==="
echo "Режим наблюдения: ничего не блокируется, профиль не применяется."
echo

# Логи Electron в stderr нам не нужны: читается наш разбор. Процесс остаётся на
# переднем плане, Ctrl+C гасит его вместе с окном — ничего не остаётся висеть.
exec "$ELECTRON" "$ROOT/tools/discover/main.js" --url "$URL" "$@"
