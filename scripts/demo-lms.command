#!/bin/bash
# ПОКАЗ ДЛЯ ЖЮРИ: встроенный браузер оболочки открывает настоящий Moodle вуза,
# всё за пределами белого списка не открывается и попадает в журнал с адресом.
#
# Двойной клик по этому файлу — и можно показывать. Учётные записи не нужны:
# демонстрируется работоспособность окна и фильтра, а не прохождение теста.
#
# Запускается из Terminal.app: разрешение на камеру macOS выдаёт приложению,
# владеющему процессом, а не Python.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

LMS_URL="${PROCTOR_DEMO_LMS:-https://lms.astanait.edu.kz/login/index.php}"
LMS_HOST="$(printf '%s' "$LMS_URL" | sed -E 's#^[a-z]+://##; s#/.*##')"
EXAMDIR="${PROCTOR_DEMO_DIR:-$HOME/Documents/proctor-demo}"
# Папка проктора, куда после экзамена копируется пакет. В этом показе не нужна
# (он про браузер, а не про передачу), поэтому по умолчанию не задана:
#   DELIVER_DIR=~/Documents/proctor-deliver scripts/demo-lms.command
DELIVER_DIR="${DELIVER_DIR-${PROCTOR_DELIVER_DIR:-}}"

mkdir -p "$EXAMDIR" || { echo "Не удалось создать $EXAMDIR"; read -r _; exit 1; }

cat > "$EXAMDIR/exam-profile.json" <<JSON
{
  "exam_url": "$LMS_URL",
  "allowed_origins": ["$LMS_HOST", "login.microsoftonline.com", "aadcdn.msftauth.net",
                      "aadcdn.msauth.net", "logincdn.msftauth.net", "login.live.com"],
  "allow_search": false,
  "institution": "Astana IT University",
  "exam_id": "DEMO-LMS",
  "issued_by": "Evelina Penkova, команда проекта",
  "issued_at": "2026-10-08",
  "notes": "Показ работоспособности встроенного браузера и фильтра источников."
}
JSON

clear
cat <<'TXT'
==========================================================
  ПОКАЗ: встроенный браузер и фильтр источников
==========================================================

ЧТО ПОКАЗЫВАЕМ
  Оболочка открывает настоящий Moodle вуза в своём окне,
  вход через Microsoft работает (домены входа в белом списке).
  Всё, чего нет в белом списке, не открывается и попадает
  в журнал с полным адресом — это видно сразу в панели
  наблюдения справа.

ПОРЯДОК НА СЦЕНЕ
  1. Пройдите согласие и предполётную проверку.
     Если проверка упрётся в запущенные программы — нажмите
     «Открыть страницу теста без экзаменационного режима»:
     кнопка появляется только в непригодном для экзамена
     запуске и это честно отмечается в отчёте.
  2. Калибровку можно пройти быстро либо пропустить этапы,
     которые не нужны для показа браузера.
  3. На экране экзамена откроется страница входа Moodle.
     Прокрутите, нажмите на поля — окно живое.
  4. Нажмите «Войти через Microsoft» — откроется страница входа
     Microsoft: она разрешена профилем. Вводить пароль не нужно.
  5. Блокировка видна сама: страница вуза тянет скрипт со
     стороннего домена, которого нет в профиле, — в ленте
     наблюдения появится инцидент с полным адресом.
     Любая ссылка на посторонний сайт (поисковик, соцсеть,
     сноски внизу страницы Microsoft) тоже не откроется
     и попадёт в журнал.
  6. Завершите тест — в отчёте будет раздел попыток выхода
     и строка о том, какой профиль действовал.

ЧЕГО НЕ ДЕЛАЕМ
  Вход в Moodle не выполняется, учётные данные не вводятся.
  Показывается работа окна и фильтра, а не прохождение теста.

TXT
echo "Адрес:          $LMS_URL"
echo "Разрешены:      $LMS_HOST и домены входа Microsoft"
echo "Профиль:        $EXAMDIR/exam-profile.json"
echo "Пакет сессии:   $EXAMDIR"
echo "Папка проктора: ${DELIVER_DIR:-не задана — пакет останется рядом с сессией}"
echo
printf 'Проверяю доступность сайта... '
if curl -s -o /dev/null --max-time 8 "$LMS_URL"; then
    echo "отвечает."
else
    echo "НЕ ОТВЕЧАЕТ."
    echo "Проверьте сеть. Без сайта показ браузера не получится;"
    echo "запасной вариант — локальная страница, см. docs/DEMO.md."
fi
echo
echo "Нажмите Enter, чтобы запустить. Остановить потом: Ctrl+C здесь."
read -r _

# Камера: на этой машине встроенная FaceTime — индекс 1, индекс 0 занимает
# iPhone как Continuity Camera. Задаётся явно, подбор вслепую уже подводил.
exec env PROCTOR_SESSIONS_DIR="$EXAMDIR" PROCTOR_CAMERA="${PROCTOR_CAMERA:-1}" \
    PROCTOR_DELIVER_DIR="$DELIVER_DIR" "$(dirname "$0")/run-safe.command"
